# Copy this file to .env.local and fill in real values.
# Never commit .env.local to GitHub.

# --- Site ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_PHONE_NUMBER=+917256942814
NEXT_PUBLIC_WHATSAPP_NUMBER=+917256942814
NEXT_PUBLIC_CONTACT_EMAIL=info@anupfabrication.in
NEXT_PUBLIC_GOOGLE_MAPS_URL=https://maps.google.com

# --- Supabase ---
# From your Supabase project: Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Settings -> API -> service_role key. Server-side only — never expose
# this to the browser, never prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- Razorpay (added later, optional — see README) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
